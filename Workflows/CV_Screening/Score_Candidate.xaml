<Activity mc:Ignorable="sap sap2010" x:Class="Score_Candidate" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Education" Type="InArgument(x:String)" />
    <x:Property Name="in_ExperienceYears" Type="InArgument(x:Double)" />
    <x:Property Name="in_MatchedReqCount" Type="InArgument(x:Int32)" />
    <x:Property Name="in_MatchedPrefCount" Type="InArgument(x:Int32)" />
    <x:Property Name="in_IsKnockoutFailed" Type="InArgument(x:Boolean)" />
    <x:Property Name="in_KnockoutReason" Type="InArgument(x:String)" />
    <x:Property Name="out_Score" Type="OutArgument(x:Double)" />
    <x:Property Name="out_Group" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence sap2010:Annotation.AnnotationText="Kalkulasi Skor Terbobot (Pendidikan 10%, Pengalaman 20%, Skill Wajib 50%, Skill Tambahan 20%) dan Pengelompokan Ambang Batas (Sesuai, Perlu Dicek, Tidak Sesuai)." DisplayName="Score_Candidate" sap:VirtualizedContainerService.HintSize="550,750" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Double" Name="eduScore" />
      <Variable x:TypeArguments="x:Double" Name="expScore" />
      <Variable x:TypeArguments="x:Double" Name="reqScore" />
      <Variable x:TypeArguments="x:Double" Name="prefScore" />
    </Sequence.Variables>
    <ui:Comment DisplayName="Mathematical Formula Note" sap:VirtualizedContainerService.HintSize="488,135" sap2010:WorkflowViewState.IdRef="Comment_1" Text="// Formula Skoring PRD:&#xA;// 1. eduScore = If(in_Education.Equals(&quot;S1&quot;), 10.0, If(in_Education.Equals(&quot;D3&quot;), 5.0, 0.0))&#xA;// 2. expScore = Math.Min(in_ExperienceYears / 2.0, 1.0) * 20.0&#xA;// 3. reqScore = (in_MatchedReqCount / 4.0) * 50.0&#xA;// 4. prefScore = (in_MatchedPrefCount / 2.0) * 20.0&#xA;// out_Score = Math.Round(eduScore + expScore + reqScore + prefScore, 1)" />
    <If Condition="[in_IsKnockoutFailed]" DisplayName="Check Knockout Result" sap:VirtualizedContainerService.HintSize="488,432" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Assign DisplayName="Group: TIDAK_SESUAI" sap:VirtualizedContainerService.HintSize="434,82" sap2010:WorkflowViewState.IdRef="Assign_1">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">TIDAK_SESUAI</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
      <If.Else>
        <If Condition="[out_Score &gt;= 75.0]" DisplayName="Check Score Threshold" sap:VirtualizedContainerService.HintSize="434,222" sap2010:WorkflowViewState.IdRef="If_2">
          <If.Then>
            <Assign DisplayName="Group: SESUAI" sap:VirtualizedContainerService.HintSize="262,60" sap2010:WorkflowViewState.IdRef="Assign_2">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">SESUAI</InArgument>
              </Assign.Value>
            </Assign>
          </If.Then>
          <If.Else>
            <Assign DisplayName="Group: PERLU_DICEK" sap:VirtualizedContainerService.HintSize="262,60" sap2010:WorkflowViewState.IdRef="Assign_3">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">PERLU_DICEK</InArgument>
              </Assign.Value>
            </Assign>
          </If.Else>
        </If>
      </If.Else>
    </If>
  </Sequence>
</Activity>
