  <Sequence sap2010:Annotation.AnnotationText="Kalkulasi Skor Terbobot (Pendidikan 10%, Pengalaman 20%, Skill Wajib 50%, Skill Tambahan 20%) dan Pengelompokan Ambang Batas (SESUAI, PERLU_DICEK, TIDAK_SESUAI)." DisplayName="Score_Candidate" sap:VirtualizedContainerService.HintSize="550,920" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Double" Name="eduScore" />
      <Variable x:TypeArguments="x:Double" Name="expScore" />
      <Variable x:TypeArguments="x:Double" Name="reqScore" />
      <Variable x:TypeArguments="x:Double" Name="prefScore" />
    </Sequence.Variables>
    <Assign DisplayName="Compute Education Score (10%)" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_EduScore">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[eduScore]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[If(in_Education.Equals("S1") OrElse in_Education.Equals("S2"), 10.0, If(in_Education.Equals("D3"), 5.0, 0.0))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Compute Experience Score (20%)" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_ExpScore">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[expScore]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[Math.Min(in_ExperienceYears / 2.0, 1.0) * 20.0]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Compute Required Skill Score (50%)" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_ReqScore">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[reqScore]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[Math.Min(in_MatchedReqCount / 4.0, 1.0) * 50.0]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Compute Preferred Skill Score (20%)" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_PrefScore">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[prefScore]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[Math.Min(in_MatchedPrefCount / 2.0, 1.0) * 20.0]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Calculate Total Score" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_TotalScore">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[out_Score]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[Math.Round(eduScore + expScore + reqScore + prefScore, 1)]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Build Score Breakdown JSON" sap:VirtualizedContainerService.HintSize="488,82" sap2010:WorkflowViewState.IdRef="Assign_Breakdown">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_BreakdownJson]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[New JArray(New JObject(New JProperty("label", "Pendidikan (10%)"), New JProperty("score", Math.Round(eduScore, 1)), New JProperty("max", 10)), New JObject(New JProperty("label", "Pengalaman (20%)"), New JProperty("score", Math.Round(expScore, 1)), New JProperty("max", 20)), New JObject(New JProperty("label", "Skill Wajib (50%)"), New JProperty("score", Math.Round(reqScore, 1)), New JProperty("max", 50)), New JObject(New JProperty("label", "Skill Tambahan (20%)"), New JProperty("score", Math.Round(prefScore, 1)), New JProperty("max", 20))).ToString()]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[in_IsKnockoutFailed OrElse out_Score &lt; 55.0]" DisplayName="Check Knockout Or Below Minimum" sap:VirtualizedContainerService.HintSize="488,360" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Assign DisplayName="Group: TIDAK_SESUAI" sap:VirtualizedContainerService.HintSize="434,82" sap2010:WorkflowViewState.IdRef="Assign_1">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">TIDAK_SESUAI</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
      <If.Else>
        <If Condition="[out_Score &gt;= 75.0 AndAlso (in_Confidence &lt;= 0 OrElse in_Confidence &gt;= 0.6)]" DisplayName="Check Score Threshold" sap:VirtualizedContainerService.HintSize="434,222" sap2010:WorkflowViewState.IdRef="If_2">
          <If.Then>
            <Assign DisplayName="Group: SESUAI" sap:VirtualizedContainerService.HintSize="262,82" sap2010:WorkflowViewState.IdRef="Assign_2">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">SESUAI</InArgument>
              </Assign.Value>
            </Assign>
          </If.Then>
          <If.Else>
            <Assign DisplayName="Group: PERLU_DICEK" sap:VirtualizedContainerService.HintSize="262,82" sap2010:WorkflowViewState.IdRef="Assign_3">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_Group]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">PERLU_DICEK</InArgument>
              </Assign.Value>
            </Assign>
          </If.Else>
        </If>
      </If.Else>
    </If>
