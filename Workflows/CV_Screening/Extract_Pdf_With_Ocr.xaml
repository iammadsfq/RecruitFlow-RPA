  <Sequence sap2010:Annotation.AnnotationText="Mengekstrak teks PDF CV via Read PDF Text, dengan deteksi teks pendek/scan (ambang OCR) untuk menurunkan confidence dan menandai tinjauan manual jika berkas tidak terbaca." DisplayName="Extract_Pdf_With_Ocr" sap:VirtualizedContainerService.HintSize="540,760" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="minThreshold" />
    </Sequence.Variables>
    <Assign DisplayName="Resolve Min Chars" sap:VirtualizedContainerService.HintSize="478,82" sap2010:WorkflowViewState.IdRef="Assign_Min">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[minThreshold]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[If(in_MinChars &gt; 0, in_MinChars, 200)]</InArgument>
