              <ui:LogMessage DisplayName="Log PDF Exception" sap:VirtualizedContainerService.HintSize="338,143" sap2010:WorkflowViewState.IdRef="LogMessage_Err" Level="Warn" Message="[&quot;[Extract_Pdf_With_Ocr] Gagal membaca PDF: &quot; &amp; ex.Message]" />
              <Assign DisplayName="Clear Text" sap:VirtualizedContainerService.HintSize="338,82" sap2010:WorkflowViewState.IdRef="Assign_ErrTxt">
