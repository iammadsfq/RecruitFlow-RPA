    </Assign>
    <Assign DisplayName="Init Defaults" sap:VirtualizedContainerService.HintSize="478,82" sap2010:WorkflowViewState.IdRef="Assign_Def">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[out_UsedOcr]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
      </Assign.Value>
    </Assign>
    <TryCatch DisplayName="Read PDF Text With Low-Text Guard" sap:VirtualizedContainerService.HintSize="478,520" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Sequence DisplayName="Extract Text" sap:VirtualizedContainerService.HintSize="440,420" sap2010:WorkflowViewState.IdRef="Sequence_Try">
          <updf:ReadPDFText PreserveFormatting="{x:Null}" DisplayName="Read PDF Text" FileName="[in_PdfPath]" sap:VirtualizedContainerService.HintSize="400,82" sap2010:WorkflowViewState.IdRef="ReadPDFText_1" Range="All" Text="[out_Text]" />
          <If Condition="[String.IsNullOrWhiteSpace(out_Text) OrElse out_Text.Trim().Length &lt; minThreshold]" DisplayName="Check Short Or Scanned Text" sap:VirtualizedContainerService.HintSize="400,280" sap2010:WorkflowViewState.IdRef="If_Ocr">
            <If.Then>
              <Sequence DisplayName="Flag Low Text Confidence" sap:VirtualizedContainerService.HintSize="380,220" sap2010:WorkflowViewState.IdRef="Sequence_Ocr">
                <ui:LogMessage DisplayName="Log Short PDF Warning" sap:VirtualizedContainerService.HintSize="338,143" sap2010:WorkflowViewState.IdRef="LogMessage_Warn" Level="Warn" Message="[&quot;[Extract_Pdf_With_Ocr] Teks PDF di bawah ambang minimum, menandai perlu OCR/tinjauan: &quot; &amp; in_PdfPath]" />
                <Assign DisplayName="Mark Used OCR Flag" sap:VirtualizedContainerService.HintSize="338,82" sap2010:WorkflowViewState.IdRef="Assign_UsedOcr">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[out_UsedOcr]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Set Low Text Confidence" sap:VirtualizedContainerService.HintSize="338,82" sap2010:WorkflowViewState.IdRef="Assign_ConfOcr">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[out_Confidence]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[If(String.IsNullOrWhiteSpace(out_Text) OrElse out_Text.Trim().Length &lt; 30, 0.3, 0.72)]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <Assign DisplayName="Set Native PDF Confidence" sap:VirtualizedContainerService.HintSize="338,82" sap2010:WorkflowViewState.IdRef="Assign_ConfNative">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Double">[out_Confidence]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Double">[0.96]</InArgument>
                </Assign.Value>
              </Assign>
            </If.Else>
          </If>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
