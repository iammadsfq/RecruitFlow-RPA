    <Assign DisplayName="Detect Education" sap:VirtualizedContainerService.HintSize="518,82" sap2010:WorkflowViewState.IdRef="Assign_Edu">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Education]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(Regex.IsMatch(lowerText, "\b(s2|magister|master)\b"), "S2", If(Regex.IsMatch(lowerText, "\b(s1|sarjana|bachelor|d4|teknik informatika|ilmu komputer)\b"), "S1", If(Regex.IsMatch(lowerText, "\b(d3|diploma)\b"), "D3", If(Regex.IsMatch(lowerText, "\b(sma|smk|sederajat)\b"), "SMA", If(appObj("education") IsNot Nothing, appObj("education").ToString(), "SMA")))))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Detect Experience Years" sap:VirtualizedContainerService.HintSize="518,82" sap2010:WorkflowViewState.IdRef="Assign_Exp">
